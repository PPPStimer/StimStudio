/* VSCode-like dark theme for StimStudio (based on WaveHowl) */

* {
    font-family: "Segoe UI", "Cascadia Code", sans-serif;
    font-size: 13px;
    color: #cccccc;
}

QMainWindow, QWidget {
    background-color: #1e1e1e;
}

/* Activity bar (far-left vertical strip) */
#activityBar {
    background-color: #333333;
    min-width: 48px;
    max-width: 48px;
}
#activityBar QToolButton {
    background: transparent;
    border: none;
    color: #d0d0d0;
    padding: 12px 4px;
    font-size: 18px;
}
#activityBar QToolButton:hover {
    color: #ffffff;
}
#activityBar QToolButton:checked {
    color: #ffffff;
    border-left: 2px solid #007acc;
}

/* Sidebar */
#sidebar {
    background-color: #252526;
    min-width: 200px;
}
#sidebarTitle {
    color: #bbbbbb;
    font-size: 11px;
    padding: 8px 12px 4px 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QListWidget {
    background-color: #252526;
    border: none;
    outline: 0;
}
QListWidget::item {
    padding: 6px 12px;
    border: none;
}
QListWidget::item:hover {
    background-color: #2a2d2e;
}
QListWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* Panels */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    margin-top: 14px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9cdcfe;
}

QLabel { background: transparent; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: #094771;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #007acc;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    selection-background-color: #094771;
    border: 1px solid #3c3c3c;
}

QPushButton {
    background-color: #0e639c;
    border: none;
    border-radius: 3px;
    padding: 6px 14px;
    color: #ffffff;
}
QPushButton:hover { background-color: #1177bb; }
QPushButton:pressed { background-color: #0d5a8f; }
QPushButton:disabled { background-color: #3c3c3c; color: #777777; }

QPushButton#secondary {
    background-color: #3a3d41;
}
QPushButton#secondary:hover { background-color: #45494e; }

QCheckBox { spacing: 6px; }

/* Menu / toolbar / statusbar */
QMenuBar { background-color: #3c3c3c; }
QMenuBar::item:selected { background-color: #094771; }
QMenu { background-color: #252526; border: 1px solid #454545; }
QMenu::item:selected { background-color: #094771; }

QToolBar {
    background-color: #2d2d2d;
    border: none;
    spacing: 4px;
    padding: 3px;
}

QStatusBar {
    background-color: #007acc;
    color: #ffffff;
}
QStatusBar QLabel { color: #ffffff; }

QScrollBar:vertical {
    background: #1e1e1e;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #424242;
    min-height: 24px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #4f4f4f; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

QSplitter::handle { background-color: #1e1e1e; }

/* ── StimStudio additions ─────────────────────────────────────────────── */
QScrollBar:horizontal {
    background: #1e1e1e;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #424242;
    min-width: 24px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #4f4f4f; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QDockWidget { titlebar-close-icon: none; color: #bbbbbb; }
QDockWidget::title {
    background-color: #252526;
    padding: 4px 8px;
    text-transform: uppercase;
    font-size: 11px;
}
QMainWindow::separator { background: #2d2d2d; width: 3px; height: 3px; }
QMainWindow::separator:hover { background: #007acc; }

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px 6px;
}
QToolButton:hover { background-color: #3a3d41; }
QToolButton:checked { background-color: #094771; border-color: #007acc; }

QTreeWidget {
    background-color: #252526;
    border: none;
    outline: 0;
}
QTreeWidget::item { padding: 3px 2px; }
QTreeWidget::item:hover { background-color: #2a2d2e; }
QTreeWidget::item:selected { background-color: #094771; color: #ffffff; }

QScrollArea { border: none; }

/* track headers */
#trackHeader { background-color: #252526; border-bottom: 1px solid #1a1a1a; }
#trackHeader[selected="true"] { background-color: #2c3440; }
#laneHeader { background-color: #202021; border-bottom: 1px solid #1a1a1a; }
#laneHeader QLabel { font-size: 11px; }
#trackHeader QLineEdit { background: transparent; border: 1px solid transparent; padding: 1px 3px; }
#trackHeader QLineEdit:focus { background: #3c3c3c; border: 1px solid #007acc; }
#trackHeader QToolButton, #laneHeader QToolButton {
    min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px;
    padding: 0; font-size: 11px; font-weight: bold; background-color: #333337;
}
#trackHeader QToolButton#mute:checked, #laneHeader QToolButton#mute:checked {
    background-color: #b5651d; border-color: #e08a3c; color: #ffffff;
}
#trackHeader QToolButton#solo:checked { background-color: #a89a1c; border-color: #e0d23c; color: #000000; }
#trackHeader QToolButton#expand { background: transparent; }
#trackHeader QToolButton#frames:checked, #trackHeader QToolButton#audio:checked {
    background-color: #094771; border-color: #007acc; color: #ffffff; }
#trackHeader QComboBox { padding: 1px 4px; font-size: 11px; }

#timeLabel {
    font-family: "Cascadia Code", Consolas, monospace;
    font-size: 15px;
    color: #4ec9b0;
    background: #111111;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 2px 8px;
}

/* effects / automation */
#fxCard { background-color: #252526; border: 1px solid #333337; border-radius: 4px; }
#fxCard QToolButton { min-width: 18px; padding: 1px 4px; background-color: #333337; }
#fxCard QToolButton#chan:checked { background-color: #094771; border-color: #007acc; }
#fxCard QToolButton#auto { font-size: 11px; }
#fxCard QToolButton#auto:checked { background-color: #5a2d63; border-color: #c586c0; color: #ffffff; }
#laneHeader QToolButton#env:checked { background-color: #5a2d63; border-color: #c586c0; color: #ffffff; }
#laneHeader QComboBox { padding: 0 2px; font-size: 11px; }
